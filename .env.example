APP_NAME="Agenda Escenarios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost:8090
APP_PORT=8090
VITE_PORT=5177
FORWARD_DB_PORT=3317

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agenda_escenarios
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FEDERACIÓN (SimpleSAML) --------------------------------------------------
# Mientras la universidad no entregue los metadatos definitivos del IdP,
# usa el simulador (mismo patrón que ../redi/redi-app): activa
# SAML_SIMULATOR=true en tu .env local y el login se resuelve con estos
# datos sin contactar a ningún IdP.
SAML_SIMULATOR=true
SAML_SIMULATOR_EMAIL=docente@ucol.mx
SAML_SIMULATOR_NAME="Rodriguez Ortiz Miguel Angel"
SAML_SIMULATOR_FIRSTNAME="Miguel Angel"
SAML_SIMULATOR_LASTNAME="Rodríguez Ortiz"

# Login real (SAML_SIMULATOR=false): IdP de prueba de DGRE, mismo host que
# usa `redi` (ver ../redi/redi-app/.env.example). SAML2_TEST_SP_ENTITYID debe
# ser distinto por app y registrarse con el administrador del IdP.
SAML2_TEST_IDP_HOST=https://dgre2.ucol.mx/simplesaml
SAML2_TEST_IDP_ENTITYID=https://dgre2.ucol.mx/idp/
SAML2_TEST_IDP_x509=
SAML2_TEST_SP_ENTITYID=
